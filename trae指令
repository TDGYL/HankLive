                }];
客队球员坐标计算为：
                CGFloat centerX = (100 - model.x)/100.0 * totalWidth;
                CGFloat centerY = (100 - model.y)/100.0 * itemHeight/2  + itemHeight/2;
                [view mas_makeConstraints:^(MASConstraintMaker *make) {
                    make.centerX.mas_equalTo(self.mas_left).offset(centerX);
